{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kirion.dev/schemas/sandbox-capsule.schema.json",
  "title": "Forge Sandbox Capsule",
  "type": "object",
  "required": ["capsule_version", "repository", "source_branch", "source_sha", "target_branch", "worktree_status", "commands_executed", "known_failures", "known_unverified_claims", "next_permitted_action", "created_at", "created_by_role"],
  "properties": {
    "capsule_version": {"const": 1},
    "repository": {"type": "string"},
    "remote": {"type": ["string", "null"]},
    "source_branch": {"type": "string"},
    "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "target_branch": {"type": "string"},
    "candidate_head": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "worktree_status": {"type": "string"},
    "staged_diff": {"type": ["string", "null"]},
    "unstaged_diff": {"type": ["string", "null"]},
    "untracked_manifest": {"type": ["string", "null"]},
    "environment": {"type": ["object", "string", "null"]},
    "runtime_versions": {"type": ["object", "array", "string", "null"]},
    "dependency_state": {"type": ["object", "array", "string", "null"]},
    "commands_executed": {"type": "array", "items": {"type": "string"}},
    "tests_run": {"type": "array", "items": {"type": "string"}},
    "builds_run": {"type": "array", "items": {"type": "string"}},
    "runtime_checks": {"type": "array", "items": {"type": "string"}},
    "known_failures": {"type": "array", "items": {"type": "string"}},
    "known_unverified_claims": {"type": "array", "items": {"type": "string"}},
    "blocker": {"type": ["string", "null"]},
    "candidate_commits": {"type": "array", "items": {"type": "string"}},
    "remote_branch_state": {"type": ["object", "string", "null"]},
    "artifacts": {"type": "array", "items": {"type": "object"}},
    "next_recommended_action": {"type": ["string", "null"]},
    "next_permitted_action": {"type": "string", "minLength": 1},
    "created_at": {"type": "string"},
    "created_by_role": {"type": "string"}
  },
  "additionalProperties": false
}
