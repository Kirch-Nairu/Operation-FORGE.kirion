{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kirion.dev/schemas/nest.schema.json",
  "title": "Forge Nest Record",
  "type": "object",
  "required": ["schema_version", "project", "repository", "maturity", "status"],
  "properties": {
    "schema_version": {"const": 1},
    "project": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "minLength": 1},
    "maturity": {"enum": ["NEST-0", "NEST-1", "NEST-2", "NEST-3", "NEST-4"]},
    "status": {"type": "string", "minLength": 1},
    "authority_ref": {"type": ["string", "null"]},
    "authority_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "verified_at": {"type": ["string", "null"], "format": "date-time"}
  },
  "additionalProperties": true
}
